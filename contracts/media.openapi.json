        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "FileState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "disabled"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "disabled": {
            "type": "boolean"
          }
        }
      },
      "FilePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "ArchiveRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "references"
        ],
        "properties": {
          "references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "ArchiveEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "version_id",
          "path",
          "filename",
          "size",
          "sha256"
        ],
        "properties": {
          "reference_id": {
            "type": "string"
          },
          "version_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "ArchiveManifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entries",
          "total_size"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArchiveEntry"
            }
          },
          "total_size": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "File": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "disabled",
          "deleting",
          "revision",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "deleting": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
