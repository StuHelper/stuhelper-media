            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Version"
            }
          }
        }
      },
      "Reference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file_id",
          "version_id",
          "module",
          "resource_id",
          "state",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file_id": {
            "type": "string"
          },
          "version_id": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "resource_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UploadRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "filename",
          "content_type",
          "size",
          "sha256"
        ],
        "properties": {
          "file_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reuse_existing": {
            "type": "boolean",
            "default": false,
            "description": "Attempt to reuse a completed upload owned by the current user with the same purpose, configured protection, content type, size and SHA-256. A different user digest alone never skips upload."
          }
        }
      },
      "Binding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "resource_id"
        ],
        "properties": {
