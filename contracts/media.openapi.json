  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "SanitizedFailure": {
        "description": "Sanitized failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file_id",
          "number",
          "revision",
          "upload_id",
          "filename",
          "content_type",
          "size",
          "sha256",
          "state",
          "approved",
          "upload_expires_at",
          "retain_until",
          "cleanup_complete",
          "error_code"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file_id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int64"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "upload_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "sha256": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "upload_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "retain_until": {
            "type": "string",
            "format": "date-time"
          },
          "cleanup_complete": {
            "type": "boolean",
            "description": "This version has released its storage handle. Shared bytes remain while other handles use them. If this is the final handle, true requires physical cleanup to finish."
          },
          "error_code": {
            "type": "string"
          },
          "reused": {
            "type": "boolean",
            "description": "True when this independent version uses a verified prior upload without sending client file bytes. It still requires its own business approval. While verifying, query the upload status and do not send file bytes."
          }
        }
      },
      "VersionView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file_id",
          "number",
          "revision",
          "upload_id",
          "filename",
          "content_type",
          "size",
          "sha256",
          "state",
          "approved",
          "upload_expires_at",
          "retain_until",
          "cleanup_complete",
          "error_code",
          "storage_state",
          "healthy",
          "desired"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file_id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int64"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "upload_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "sha256": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "upload_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "retain_until": {
            "type": "string",
            "format": "date-time"
          },
          "cleanup_complete": {
            "type": "boolean",
            "description": "This version has released its storage handle. Shared bytes remain while other handles use them. If this is the final handle, true requires physical cleanup to finish."
          },
          "error_code": {
            "type": "string"
          },
          "storage_state": {
            "type": "string"
          },
          "healthy": {
            "type": "integer",
            "format": "int64"
          },
          "desired": {
            "type": "integer",
            "format": "int64"
          },
          "reused": {
            "type": "boolean",
            "description": "True when this independent version uses a verified prior upload without sending client file bytes. It still requires its own business approval. While verifying, query the upload status and do not send file bytes."
          }
        }
      },
      "FileView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "disabled",
          "deleting",
          "revision",
          "created_at",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "deleting": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
